{
  "name": "@bang/root",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "demo:m000": "bun run scripts/demo-m000.ts",
    "demo:m001": "bun run scripts/demo-m001.ts",
    "dev": "bun --watch scripts/demo-m001.ts",
    "effect:setup": "effect-tsgo patch --typescript --oxlint",
    "check:effect-lsp": "bun run scripts/check-effect-lsp.ts",
    "hooks:install": "bun run scripts/install-git-hooks.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "fix": "bun run scripts/fix.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run effect:setup && bun run typecheck && bun run check:effect-lsp && bun run lint && bun run format:check",
    "preview": "bun run demo:m000 && bun run demo:m001",
    "verify": "bun run check && bun run test && bun run preview && bun run build",
    "prepare": "bun run effect:setup && bun run hooks:install"
  },
  "dependencies": {
    "effect": "4.0.0-rc.108"
  },
  "devDependencies": {
    "@bang/core": "workspace:*",
    "@bang/target-effect": "workspace:*",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@effect/tsgo": "0.36.4",
    "@types/bun": "1.3.14",
    "oxfmt": "0.61.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
