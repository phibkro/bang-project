{
  "bangCore": 1,
  "declarations": [
    {
      "kind": "stateMachine",
      "id": "Account",
      "state": {
        "id": "AccountState",
        "fields": [{ "id": "balance", "type": "Integer" }]
      },
      "initializers": [
        {
          "id": "initialize",
          "parameters": [{ "id": "initialBalance", "type": "Integer" }],
          "requires": [
            {
              "kind": "greaterThanOrEqual",
              "left": { "kind": "parameter", "id": "initialBalance" },
              "right": { "kind": "integerLiteral", "value": "0" }
            }
          ]
        }
      ],
      "transitions": [
        {
          "id": "withdraw",
          "parameters": [{ "id": "amount", "type": "Integer" }],
          "requires": [
            {
              "kind": "greaterThanOrEqual",
              "left": { "kind": "parameter", "id": "amount" },
              "right": { "kind": "integerLiteral", "value": "0" }
            },
            {
              "kind": "greaterThanOrEqual",
              "left": { "kind": "stateField", "field": "balance" },
              "right": { "kind": "parameter", "id": "amount" }
            }
          ]
        }
      ],
      "invariants": [
        {
          "id": "nonnegativeBalance",
          "proposition": {
            "kind": "greaterThanOrEqual",
            "left": { "kind": "stateField", "field": "balance" },
            "right": { "kind": "integerLiteral", "value": "0" }
          }
        }
      ]
    },
    { "kind": "capability", "id": "DebitAccount" },
    {
      "kind": "operationRealization",
      "id": "WithdrawAccount",
      "operation": { "stateMachine": "Account", "operation": "withdraw" },
      "requires": ["DebitAccount"],
      "disabled": { "kind": "failure", "id": "WithdrawalRejected" }
    }
  ]
}
